{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Core defaults and the app commands it calls, no shell, fs or http plugins (NFR-SEC-01).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-set-tile-interest",
    "allow-project-state",
    "allow-new-project",
    "allow-open-project",
    "allow-save-project",
    "allow-save-project-as",
    "allow-confirm-close",
    "allow-execute",
    "allow-undo",
    "allow-redo",
    "allow-export-project",
    "allow-app-settings",
    "allow-set-app-settings",
    "allow-dev-startup",
    "allow-dev-report-frame-times",
    "allow-dev-log"
  ]
}
